   Check "$label.$view-not-paused-during-C-creation" ($y.work.counter -gt $x.work.counter -and [array]::IndexOf($rows,$x) -lt [array]::IndexOf($rows,$ccreated) -and [array]::IndexOf($rows,$ccreated) -lt [array]::IndexOf($rows,$y))
  }
 
